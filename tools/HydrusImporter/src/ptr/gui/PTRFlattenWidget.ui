         <item row="8" column="0">
             <widget class="QLabel" name="unusedTagsLabel">
                 <property name="text">
                     <string>Tags disregarded (unused):</string>
                 </property>
                 <property name="toolTip">
                     <string>Tags the PTR defined but that were never written to a chunk or a relation, and so are never
                         created in IDHAN.

                         Every one of their mappings was superseded, addressed a record with no hash definition, or
                         survived only as a discarded removal.

                         Only known once the relations file has been written, so this stays pending until the run
                         finishes.
                     </string>
                 </property>
             </widget>
