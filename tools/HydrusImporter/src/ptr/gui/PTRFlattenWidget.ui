      <item row="2" column="0">
       <widget class="QLabel" name="chainsCollapsedLabel">
        <property name="text">
         <string>Chains collapsed:</string>
        </property>
           <property name="toolTip">
               <string>Mapping events discarded because a later event for the same record and tag superseded them.

                   The PTR records every add and removal ever made. Only the outcome of each history is worth importing,
                   and this is how much of it that leaves behind.
               </string>
           </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QLabel" name="chainsCollapsedValue">
