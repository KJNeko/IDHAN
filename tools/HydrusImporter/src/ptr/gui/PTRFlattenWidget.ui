       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="terminalDeletesLabel">
        <property name="text">
         <string>Terminal deletes kept:</string>
        </property>
           <property name="toolTip">
               <string>Tag removals whose history ended in a delete, replayed at import as removeTags.

                   They collapse to the removal alone, never to a paired add, so they have no effect on records whose
                   tags came only from this PTR import.
               </string>
           </property>
       </widget>
      </item>
