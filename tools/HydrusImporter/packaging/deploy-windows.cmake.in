set(QT_DEPLOY_BIN_DIR .)
qt6_deploy_runtime_dependencies(
	EXECUTABLE "$<TARGET_FILE:HydrusImporter>"
	BIN_DIR .
	GENERATE_QT_CONF
	INCLUDE_PLUGINS qwindows qoffscreen
	NO_TRANSLATIONS)

# windeployqt installs Qt and its plugins; collect the non-Qt DLLs they depend on too.
if ("@CMAKE_CXX_COMPILER_ID@" STREQUAL "GNU")
	set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL objdump)
	set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "@CMAKE_OBJDUMP@")
endif ()

file(GLOB_RECURSE IMPORTER_PLUGINS "${CMAKE_INSTALL_PREFIX}/*.dll")
file(GET_RUNTIME_DEPENDENCIES
	EXECUTABLES "${CMAKE_INSTALL_PREFIX}/$<TARGET_FILE_NAME:HydrusImporter>"
	MODULES ${IMPORTER_PLUGINS}
	DIRECTORIES "${CMAKE_INSTALL_PREFIX}" "@IMPORTER_COMPILER_BIN@"
	# Match Windows API-set names such as api-ms-win-core-file-l1-1-0.dll.
	PRE_EXCLUDE_REGEXES "api-ms-.*" "ext-ms-.*"
	RESOLVED_DEPENDENCIES_VAR IMPORTER_DEPENDENCIES
	UNRESOLVED_DEPENDENCIES_VAR IMPORTER_UNRESOLVED)

if (IMPORTER_UNRESOLVED)
	message(FATAL_ERROR "Missing Hydrus Importer runtime DLLs: ${IMPORTER_UNRESOLVED}")
endif ()

file(TO_CMAKE_PATH "$ENV{SystemRoot}" IMPORTER_SYSTEM_ROOT)
string(TOLOWER "${IMPORTER_SYSTEM_ROOT}" IMPORTER_SYSTEM_ROOT)
foreach (IMPORTER_DEPENDENCY IN LISTS IMPORTER_DEPENDENCIES)
	string(TOLOWER "${IMPORTER_DEPENDENCY}" IMPORTER_DEPENDENCY_LOWER)
	cmake_path(IS_PREFIX IMPORTER_SYSTEM_ROOT "${IMPORTER_DEPENDENCY_LOWER}" NORMALIZE IMPORTER_SYSTEM_DLL)
	if (IMPORTER_SYSTEM_DLL)
		continue()
	endif ()

	get_filename_component(IMPORTER_DLL_NAME "${IMPORTER_DEPENDENCY}" NAME)
	if (EXISTS "${CMAKE_INSTALL_PREFIX}/${IMPORTER_DLL_NAME}")
		continue()
	endif ()

	file(INSTALL "${IMPORTER_DEPENDENCY}" DESTINATION "${CMAKE_INSTALL_PREFIX}")
endforeach ()
