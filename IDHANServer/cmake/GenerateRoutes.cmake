# Remove C++ comments and literal contents before looking for annotations. Work
# token by token rather than character by character so large headers remain cheap.
function(idhan_route_code TEXT OUTPUT)
	set(REMAINING "${TEXT}")
	set(CODE "")
	while (NOT REMAINING STREQUAL "")
		# Matches the beginning of a C++ comment, raw string, string, or character.
		string(REGEX MATCH [=[//|/\*|R"|["']]=] TOKEN "${REMAINING}")
		if (TOKEN STREQUAL "")
			string(APPEND CODE "${REMAINING}")
			break()
		endif ()

		string(FIND "${REMAINING}" "${TOKEN}" OFFSET)
		string(SUBSTRING "${REMAINING}" 0 ${OFFSET} PREFIX)
		string(SUBSTRING "${REMAINING}" ${OFFSET} -1 TAIL)
		string(LENGTH "${TAIL}" CONSUMED)
		if (TOKEN STREQUAL "//")
			string(FIND "${TAIL}" "\n" END)
			if (NOT END EQUAL -1)
				set(CONSUMED ${END})
			endif ()
		elseif (TOKEN STREQUAL "/*")
			string(FIND "${TAIL}" "*/" END)
			if (NOT END EQUAL -1)
				math(EXPR CONSUMED "${END} + 2")
			endif ()
		elseif (TOKEN STREQUAL [=[R"]=])
			string(FIND "${TAIL}" "(" OPENING)
			if (NOT OPENING EQUAL -1)
				math(EXPR DELIMITER_LENGTH "${OPENING} - 2")
				string(SUBSTRING "${TAIL}" 2 ${DELIMITER_LENGTH} DELIMITER)
				set(CLOSING ")${DELIMITER}\"")
				string(FIND "${TAIL}" "${CLOSING}" END)
				if (NOT END EQUAL -1)
					string(LENGTH "${CLOSING}" CLOSING_LENGTH)
					math(EXPR CONSUMED "${END} + ${CLOSING_LENGTH}")
				endif ()
			endif ()
		else ()
			# Matches numeric tokens ending before a digit separator, e.g. 0xAB'CD.
			string(REGEX MATCH [=[(^|[^a-zA-Z0-9_])[0-9][a-zA-Z0-9_']*$]=] NUMBER "${PREFIX}")
			# Matches the continuation after a numeric digit separator.
			if (TOKEN STREQUAL "'" AND NOT NUMBER STREQUAL "" AND TAIL MATCHES "^'[a-zA-Z0-9]")
				string(APPEND CODE "${PREFIX}'")
				string(SUBSTRING "${TAIL}" 1 -1 REMAINING)
				continue()
			endif ()

			if (TOKEN STREQUAL "\"")
				# Matches a quoted C++ string, including escaped quotes/backslashes.
				string(REGEX MATCH [=[^"([^"\\]|\\.)*"]=] LITERAL "${TAIL}")
			else ()
				# Matches a quoted C++ character, including escaped characters.
				string(REGEX MATCH [=[^'([^'\\]|\\.)*']=] LITERAL "${TAIL}")
			endif ()
			if (NOT LITERAL STREQUAL "")
				string(LENGTH "${LITERAL}" CONSUMED)
			endif ()
		endif ()

		string(APPEND CODE "${PREFIX} ")
		string(SUBSTRING "${TAIL}" ${CONSUMED} -1 REMAINING)
	endwhile ()
	set(${OUTPUT} "${CODE}" PARENT_SCOPE)
endfunction()

function(idhan_has_route_annotations TEXT OUTPUT)
	set(WHITESPACE "[ \t\r\n]")
	# Fast candidate check: matches supported annotation types, e.g. Get{"/health"}
	# for http://localhost:16609/health, before lexing the file.
	if (NOT TEXT MATCHES "(Endpoint|Get|Post|Put|Patch|Delete)${WHITESPACE}*[{(]")
		set(${OUTPUT} FALSE PARENT_SCOPE)
		return()
	endif ()

	idhan_route_code("${TEXT}" CODE)
	# Matches complete annotation blocks after comments/literals have been removed.
	string(REGEX MATCHALL "\\[${WHITESPACE}*\\[[^]]*\\]${WHITESPACE}*\\]" ANNOTATIONS "${CODE}")
	foreach (ANNOTATION IN LISTS ANNOTATIONS)
		# Matches qualified or unqualified endpoint annotations, including combined
		# annotations such as [[= Public{}, = Get{"/health"}]].
		if (ANNOTATION MATCHES "(\\[${WHITESPACE}*\\[|,)${WHITESPACE}*=${WHITESPACE}*((idhan::)?http::)?(Endpoint|Get|Post|Put|Patch|Delete)${WHITESPACE}*[{(]")
			set(${OUTPUT} TRUE PARENT_SCOPE)
			return()
		endif ()
	endforeach ()
	set(${OUTPUT} FALSE PARENT_SCOPE)
endfunction()

function(idhan_generate_routes ROOT OUTPUT)
	file(GLOB_RECURSE SOURCES LIST_DIRECTORIES FALSE "${ROOT}/*.cpp")
	foreach (SOURCE IN LISTS SOURCES)
		file(READ "${SOURCE}" TEXT)
		idhan_has_route_annotations("${TEXT}" HAS_ROUTES)
		if (HAS_ROUTES)
			message(FATAL_ERROR "${SOURCE}: route annotations must be declared in a header")
		endif ()
	endforeach ()

	file(GLOB_RECURSE CANDIDATES LIST_DIRECTORIES FALSE
			"${ROOT}/*.hpp" "${ROOT}/*.h" "${ROOT}/*.hh" "${ROOT}/*.hxx")
	set(HEADERS "")
	foreach (HEADER IN LISTS CANDIDATES)
		file(READ "${HEADER}" TEXT)
		idhan_has_route_annotations("${TEXT}" HAS_ROUTES)
		if (HAS_ROUTES)
			file(RELATIVE_PATH RELATIVE "${ROOT}" "${HEADER}")
			list(APPEND HEADERS "${RELATIVE}")
		endif ()
	endforeach ()
	list(SORT HEADERS)
	if (NOT HEADERS)
		message(FATAL_ERROR "No annotated route headers found under ${ROOT}")
	endif ()

	set(CONTENTS "#pragma once\n\n// Generated from annotated route headers. Do not edit.\n#include \"idhan/http/routing/ReflectedRoutes.hpp\"\n\n")
	foreach (HEADER IN LISTS HEADERS)
		string(APPEND CONTENTS "#include \"${HEADER}\"\n")
	endforeach ()
	string(APPEND CONTENTS "\nnamespace idhan::httpapi::generated_routes\n{\ninline constexpr auto members { std::meta::reflect_constant_array(\n    http::reflectedRouteFunctions(^^idhan::httpapi)) };\n}\n")
	get_filename_component(DIRECTORY "${OUTPUT}" DIRECTORY)
	file(MAKE_DIRECTORY "${DIRECTORY}")
	file(WRITE "${OUTPUT}.tmp" "${CONTENTS}")
	configure_file("${OUTPUT}.tmp" "${OUTPUT}" COPYONLY)
	file(REMOVE "${OUTPUT}.tmp")
endfunction()

if (CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
	if (NOT DEFINED IDHAN_ROUTE_ROOT OR NOT DEFINED IDHAN_ROUTE_OUTPUT)
		message(FATAL_ERROR "Set IDHAN_ROUTE_ROOT and IDHAN_ROUTE_OUTPUT")
	endif ()
	idhan_generate_routes("${IDHAN_ROUTE_ROOT}" "${IDHAN_ROUTE_OUTPUT}")
endif ()
