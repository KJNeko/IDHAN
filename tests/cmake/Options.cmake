# Isolate each option graph check in a fresh cmake -P process.
foreach (COMPONENT IN ITEMS DOCS WEB SERVER DOWNLOADER TESTS CLIENT HTTP TOOLS DOWNLOADER_TESTER)
	set(BUILD_IDHAN_${COMPONENT} OFF CACHE BOOL "Test component" FORCE)
endforeach ()
set(BUILD_HYDRUS_IMPORTER OFF CACHE BOOL "Test importer" FORCE)
set(CMAKE_BUILD_TYPE Debug)

if (IDHAN_OPTIONS_CASE STREQUAL "tests")
	set(BUILD_IDHAN_TESTS ON CACHE BOOL "Test component" FORCE)
elseif (IDHAN_OPTIONS_CASE STREQUAL "docs")
	set(BUILD_IDHAN_DOCS ON CACHE BOOL "Test component" FORCE)
elseif (IDHAN_OPTIONS_CASE STREQUAL "http")
	set(BUILD_IDHAN_HTTP ON CACHE BOOL "Test component" FORCE)
elseif (IDHAN_OPTIONS_CASE STREQUAL "trace")
	set(IDHAN_ENABLE_TRACE ON CACHE BOOL "Explicit tracing override" FORCE)
else ()
	message(FATAL_ERROR "Unknown option case: ${IDHAN_OPTIONS_CASE}")
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/Options.cmake")

if (IDHAN_OPTIONS_CASE STREQUAL "tests" OR IDHAN_OPTIONS_CASE STREQUAL "docs")
	foreach (COMPONENT IN ITEMS SERVER HTTP DOWNLOADER)
		if (NOT BUILD_IDHAN_${COMPONENT})
			message(FATAL_ERROR "${IDHAN_OPTIONS_CASE} did not enable ${COMPONENT}")
		endif ()
	endforeach ()
endif ()

if (IDHAN_OPTIONS_CASE STREQUAL "http")
	if (BUILD_IDHAN_SERVER OR BUILD_IDHAN_DOWNLOADER OR BUILD_IDHAN_CLIENT)
		message(FATAL_ERROR "HTTP unexpectedly enabled unrelated components")
	endif ()
endif ()

if (IDHAN_OPTIONS_CASE STREQUAL "trace")
	if (NOT IDHAN_ENABLE_TRACE)
		message(FATAL_ERROR "Debug configuration ignored the explicit tracing option")
	endif ()
elseif (IDHAN_ENABLE_TRACE)
	message(FATAL_ERROR "Tracing should default off for a fresh Debug configuration")
endif ()
